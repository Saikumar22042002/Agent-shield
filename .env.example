# ---------------------------------------------------------------- target (your own STAGING agent)
# Registered automatically at startup if TARGET_HARNESS_ARN is set. Non-staging values are refused.
TARGET_NAME=ServiceNow agent
TARGET_HARNESS_ARN=
# arn:aws:bedrock-agentcore:<region>:<account-id>:harness/<name>-<10 chars>
TARGET_REGION=us-east-1
TARGET_QUALIFIER=
TARGET_ENVIRONMENT=staging

# ---------------------------------------------------------------- AWS credentials (never put keys here)
# Leave both empty on an EC2 VM with an instance role. Otherwise name a profile from ~/.aws/config,
# and optionally a role to assume. The identity needs bedrock-agentcore:InvokeHarness on the ARN above.
AWS_PROFILE=
AWS_ROLE_ARN=

# ---------------------------------------------------------------- server (run ONE server process per database)
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# DATABASE_URL=sqlite:////absolute/path/agentshield.db   (default: ./data/agentshield.db)
# EVIDENCE_DIR=data/evidence   raw framework outputs (PyRIT export, garak report.jsonl + log), hashed into evidence

# ---------------------------------------------------------------- access control
# Empty = local single-operator mode (bind to 127.0.0.1, operator name from the console).
# Shared deployments: name:token:role entries, comma separated; role = viewer | operator | admin.
AUTH_TOKENS=

# ---------------------------------------------------------------- connectivity check (fixed benign greeting)
CONNECTIVITY_MESSAGE=Hello. This is a connectivity check from AgentShield. Please reply briefly with what you can help with.
CONNECTIVITY_MIN_INTERVAL_S=10
CONNECTOR_TIMEOUT_S=120

# ---------------------------------------------------------------- assessment execution (enforced by the gateway)
# Providers approved plans may execute against. Add aws_agentcore only on an authorised deployment.
ASSESSMENT_PROVIDERS=local_stub,local_model
# Configured ceilings; a plan can only tighten them.
MAX_PROMPTS_PER_TECHNIQUE=5
MAX_PROMPTS_PER_RUN=50
MAX_ACTIVE_ASSESSMENTS=1
TECHNIQUE_CONCURRENCY=2
MAX_RUN_DURATION_S=900
INVOCATION_TIMEOUT_S=60
MIN_INVOCATION_INTERVAL_S=0.25
# Retries of transient target errors; each retry is its own invocation and counts toward the budgets.
INVOCATION_RETRIES=1
# 0 = no cap; enforced when the target reports usage.
TARGET_TOKEN_BUDGET=0
# Tokens the coordinator model may use per run (LLM mode).
ATTACKER_TOKEN_BUDGET=60000
# Deep Agents coordinator chat model: deterministic (scripted rules, nothing sent to a provider) | llm | auto.
# llm/auto send the coordinator's state (case ids, labels, verdicts) to GENERATION_MODEL's provider.
COORDINATOR_MODEL=deterministic
# garak runs from its own venv (default backend/.venv-garak); seconds per garak case.
GARAK_TIMEOUT_S=300
# GATEWAY_PUBLIC_URL=http://127.0.0.1:8000   where the garak subprocess reaches the gateway (default: this PORT)

# ---------------------------------------------------------------- results scoring and import
# garak detector score >= this on any output marks the attempt failed; also used for PyRIT float_scale scores.
GARAK_FAIL_THRESHOLD=0.5
MAX_UPLOAD_MB=200
# CATEGORY_MAP_FILE=backend/category_map.json

# ---------------------------------------------------------------- models  ("<provider>:<model>", provider = google_genai | groq)
# DECISION_MODEL: advisory decision + rationale on attempts. Required for reviews; never changes a verdict.
DECISION_MODEL=
# GENERATION_MODEL: the coordinator's model when COORDINATOR_MODEL=llm (or auto).
GENERATION_MODEL=groq:qwen/qwen3.8-27b
JUDGE_BATCH_LIMIT=25
GOOGLE_API_KEY=
GROQ_API_KEY=
